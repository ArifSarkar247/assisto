# Off-site backup target — copy to /home/ubuntu/.assisto_offsite.env on the
# server (chmod 600). NEVER commit the filled-in file. backup.sh uploads every
# nightly encrypted bundle here with rclone. Any S3-compatible store works.
#
# Option A — Cloudflare R2 (recommended: 10 GB free, no egress fees)
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_OFFSITE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET=true
OFFSITE_PATH=offsite:<bucket-name>/assisto
#
# Option B — AWS S3 (replace the block above)
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=AWS
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_OFFSITE_REGION=ap-south-1
# RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET=true
# OFFSITE_PATH=offsite:<bucket-name>/assisto
#
# Option C — Backblaze B2 (10 GB free)
# RCLONE_CONFIG_OFFSITE_TYPE=b2
# RCLONE_CONFIG_OFFSITE_ACCOUNT=<keyID>
# RCLONE_CONFIG_OFFSITE_KEY=<applicationKey>
# OFFSITE_PATH=offsite:<bucket-name>/assisto
