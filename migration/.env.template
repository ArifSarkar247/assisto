# ============================================================================
# Assisto secrets template — copy to /home/ubuntu/.assisto_secrets.env on the
# NEW server and fill every value. chmod 600. NEVER commit a filled copy.
#
# "Required to boot" = the app/backend won't run correctly without it.
# "Key-gated feature" = the app runs fine without it; that one feature stays a
# safe mock / honest "connect a key" state until you paste the key in the
# in-app Integrations admin (Settings → owner → Integrations) OR here.
#
# Two places keys can live:
#   (A) THIS file  — infra/boot secrets the Django process reads at startup.
#   (B) Integrations admin (encrypted at rest with INTEGRATIONS_FERNET_KEY) —
#       per-feature provider keys the OWNER pastes in the app. Prefer (B) for
#       feature keys so you can rotate them without a redeploy.
# ============================================================================

# ---- REQUIRED TO BOOT ----
DB_PASSWORD=                      # Postgres password for role "assisto" (provision.sh sets the role; use the same value)
DJANGO_SECRET_KEY=                # Django crypto (sessions/signing). Generate: python -c "import secrets;print(secrets.token_urlsafe(50))"
INTEGRATIONS_FERNET_KEY=          # Fernet key that encrypts all Integrations-admin keys at rest. Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
                                  #   ⚠ If you change this, every key saved in the Integrations admin becomes unreadable — keep the SAME value when migrating.
OWNER_ADMIN_LOGIN=                # Owner/superuser login (owner console + Integrations admin)
OWNER_ADMIN_PASSWORD=             # Owner/superuser password

# ---- CALLING (Step 6) ----
TURN_STATIC_SECRET=               # Shared secret between Django and coturn (/etc/turnserver.conf). provision.sh generates one if blank. Keep it matched on both.
TURN_HOST=assisto.asalify.com     # DOMAIN clients dial for TURN/STUN (never a raw IP). Point this A-record at the new server. Change to your own domain if you take one.
TURN_PORT=3478

# ---- ANDROID SIGNING (only on a build host; NOT needed on the app server) ----
ANDROID_KEY_ALIAS=                # Upload-key alias (keep identical — a different key = Play Store rejects the update)
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=
#   The keystore FILE itself is NOT a secret-env value — back it up separately (backup.sh includes it if present). Losing it means you can never update the app on Play.

# ============================================================================
# KEY-GATED FEATURE PROVIDERS — paste in the in-app Integrations admin (preferred)
# or here. Each line: ENV_NAME = what it unlocks.  All are OPTIONAL; the feature
# ships as an honest mock/seam until the key exists.
# ============================================================================
ANTHROPIC_API_KEY=                # AI core: chat agent, in-chat AI, quick tools, contract/cost/interview/blog/spending mocks → live. (Integrations slug: anthropic)
# --- the rest live in the Integrations admin (slug in parentheses); listed so you know what to collect ---
# FIREBASE / FCM           (push)        -> app-closed call ring, family alerts, reminder push. Upload the google-services.json + FCM server key.
# GOOGLE_MAPS_PLACES       (maps)        -> nearby services, place search, ride/food location.
# SMS_GATEWAY              (sms)         -> OTP login, family SMS alerts. (SSL Wireless / Bulk SMS BD)
# IVR_VOICE                (ivr)         -> family-care voice-call reminders.
# META_WHATSAPP_MESSENGER  (whatsapp)    -> Business WhatsApp/Messenger sales assistant, CRM lead capture. OFFICIAL Cloud API only.
# PAYMENT_PARTNER          (payments)    -> payment-ladder prefill / courier COD. Assisto NEVER holds money.
# GMAIL_GOOGLE_OAUTH       (google_oauth)-> AI Inbox, email assistant, job hunter (user's own Gmail, restricted scope).
# OCR                      (ocr)         -> doc scanner / filing / expense-voucher auto-read.
# TRANSCRIPTION            (transcription)-> voice-note / meeting-minutes auto-transcribe.
# BOOKING_PARTNER          (booking)     -> travel/itinerary live booking.
# INSTAGRAM + FB_PAGE      (instagram / messenger) -> star social inbox live DM fetch.
# WEATHER                  (weather)     -> morning brief weather slot.
# NEWS                     (news)        -> morning brief news slot.
# VOICE_CLONE              (voice_clone) -> #14 own-voice clone (native, consent-gated).
# PRICE_FEED               (price_feed)  -> #34 market price radar live prices (not in registry yet; add when you pick a provider).
# TELEGRAM_BOT             (telegram)    -> Telegram bot live (BotFather token). Inert sandbox until set.
# SPOTIFY / ADMOB                        -> if used for media/monetization, collect those too.
