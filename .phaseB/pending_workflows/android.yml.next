name: Build Assisto APK

on:
  workflow_dispatch:
    inputs:
      api_base:
        description: "Backend base URL baked into the app"
        required: false
        default: "https://api.lifeassisto.com"
  push:
    branches: [ main ]
    paths:
      - 'app/**'
      - '.github/workflows/android.yml'

concurrency:
  group: apk-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build-apk:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      # API CONTRACT GATE (m2-reality): every endpoint the Flutter app calls
      # (literal + string-built paths, ${id} normalised) must resolve to a
      # Django route that handles that HTTP method (DRF router actions and
      # <int>/<str>/<slug>/<uuid> converter shapes included). A miss means a
      # screen that can never work -> fail before spending 20 min on Gradle.
      # No DB, no network: URL resolution only, under settings_test.
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: API contract (every app endpoint has a backend route)
        env:
          DJANGO_SETTINGS_MODULE: assisto_backend.settings_test
        run: |
          python -m pip install -q -r backend/requirements.txt
          timeout 600 python tools/route_check.py --md route_check.md
      - name: Upload API contract report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: api-contract-report
          path: route_check.md
          retention-days: 14
          if-no-files-found: ignore

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Generate Android platform files
        working-directory: app
        run: flutter create --project-name assisto --org com.assisto --platforms=android .

      - name: Apply native overlay (custom Kotlin/res for native features)
        working-directory: app
        run: |
          # Native platform code (device-admin receiver #80, foreground service
          # #79, home-widget provider #196, Health Connect bits #70) lives in the
          # repo under app/android_overlay/ and is MERGED over the freshly
          # generated android/ tree. Paths mirror android/ exactly (e.g.
          # android_overlay/app/src/main/kotlin/... , .../res/xml/...). No-op if
          # the overlay is absent.
          if [ -d android_overlay ]; then
            cp -rv android_overlay/. android/
            echo "native overlay applied"
          else
            echo "no android_overlay — skipping"
          fi

      # a6 FCM: Firebase config is KEY-GATED. google-services.json lives ONLY in
      # the GOOGLE_SERVICES_JSON_B64 Actions secret (repo is public — never
      # commit it, never print it). No secret -> no file -> the Gradle plugin is
      # not applied, Firebase.initializeApp() fails inside its try/catch and the
      # app builds + launches with push silently off.
      - name: Firebase config (google-services.json from secret)
        working-directory: app
        env:
          GSJ_B64: ${{ secrets.GOOGLE_SERVICES_JSON_B64 }}
        run: |
          if [ -n "${GSJ_B64:-}" ]; then
            printf '%s' "$GSJ_B64" | base64 -d > android/app/google-services.json
            python3 - <<'PY2'
          import json
          d = json.load(open("android/app/google-services.json"))
          pk = [c["client_info"]["android_client_info"]["package_name"] for c in d.get("client", [])]
          assert "com.assisto.assisto" in pk, "google-services.json has no com.assisto.assisto client"
          print("google-services.json OK for project", d["project_info"]["project_id"])
          PY2
          else
            echo "no GOOGLE_SERVICES_JSON_B64 secret - push stays OFF in this build"
          fi

      - name: Pub get
        working-directory: app
        run: flutter pub get

      - name: Analyze (fail only on errors)
        working-directory: app
        run: |
          set +e
          flutter analyze > analyze.txt 2>&1
          cat analyze.txt
          if grep -qE "error •| error -|: error" analyze.txt; then
            echo "::error::Dart analysis found errors"; exit 1; fi
          echo "no errors"

      - name: Strict language gate (no mixed/hard-coded UI strings)
        working-directory: app
        run: python3 tool/lang_gate.py

      # First-run gate: the language picker → "Continue" → enter-app flow must
      # work deterministically (the owner-reported freeze where Continue did
      # nothing shipped because nothing proved this flow). Host-side widget test,
      # no emulator — gates the whole pipeline, so a broken Continue can't ship.
      - name: First-run language flow test (Continue must enter the app)
        working-directory: app
        run: flutter test test/language_flow_test.dart test/widget_test.dart

      - name: Generate launcher icons (adaptive)
        working-directory: app
        run: dart run flutter_launcher_icons

      - name: Generate splash screen
        working-directory: app
        run: dart run flutter_native_splash:create

      - name: Patch manifest (app name + permissions)
        working-directory: app
        run: |
          python3 - <<'PY'
          import re
          p = "android/app/src/main/AndroidManifest.xml"
          s = open(p).read()
          s = s.replace('android:label="assisto"', 'android:label="Assisto"')
          # tools: namespace for tools:node overrides.
          if 'xmlns:tools' not in s:
              s = s.replace('<manifest ', '<manifest xmlns:tools="http://schemas.android.com/tools" ', 1)
          perms = (
              '\n    <uses-permission android:name="android.permission.INTERNET"/>'
              '\n    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>'
              '\n    <uses-permission android:name="android.permission.RECORD_AUDIO"/>'
              '\n    <uses-permission android:name="android.permission.CAMERA"/>'
              '\n    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>'
              '\n    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>'
              '\n    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>'
              '\n    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>'
              '\n    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>'
              # #79 hands-free voice SOS — foreground service (mic + location)
              '\n    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>'
              '\n    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>'
              '\n    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>'
              '\n    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>'
              '\n    <uses-permission android:name="android.permission.WAKE_LOCK"/>'
              # #70 Health Connect reads
              '\n    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>'
              '\n    <uses-permission android:name="android.permission.health.READ_STEPS"/>'
              '\n    <uses-permission android:name="android.permission.health.READ_HEART_RATE"/>'
              '\n    <uses-permission android:name="android.permission.health.READ_SLEEP"/>'
              '\n    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED"/>'
              # #80 lost/stolen — alarm vibration
              '\n    <uses-permission android:name="android.permission.VIBRATE"/>\n'
          )
          if 'android.permission.INTERNET' not in s:
              s = re.sub(r'(<manifest[^>]*>)', r'\1' + perms, s, count=1)
          queries = (
              '\n    <queries>'
              '\n      <intent><action android:name="android.intent.action.DIAL"/>'
              '<data android:scheme="tel"/></intent>'
              '\n      <intent><action android:name="android.intent.action.SENDTO"/>'
              '<data android:scheme="smsto"/></intent>'
              '\n      <intent><action android:name="android.intent.action.VIEW"/></intent>'
              # #70 Health Connect visibility (so the app can resolve HC)
              '\n      <package android:name="com.google.android.apps.healthdata"/>'
              '\n    </queries>\n'
          )
          if '<queries>' not in s:
              s = re.sub(r'(<manifest[^>]*>)', r'\1' + queries, s, count=1)
          # image_cropper needs UCropActivity registered INSIDE <application>,
          # else cropping crashes at runtime (ActivityNotFoundException). Give it
          # an explicit AppCompat theme so the app theme need not be AppCompat.
          ucrop = (
              '\n        <activity android:name="com.yalantis.ucrop.UCropActivity"'
              ' android:exported="false"'
              ' android:theme="@style/Theme.AppCompat.Light.NoActionBar"/>\n'
          )
          if 'com.yalantis.ucrop.UCropActivity' not in s:
              s = s.replace('</application>', ucrop + '    </application>', 1)
          # Native-feature <application> components (classes live in the overlay):
          #   #79 voice-SOS foreground service (flutter_foreground_task),
          #   #196 home-screen widget provider, #80 device-admin receiver.
          native_components = (
              '\n        <service'
              ' android:name="com.pravera.flutter_foreground_task.service.ForegroundService"'
              ' android:foregroundServiceType="microphone|location"'
              ' android:exported="false"/>'
              '\n        <receiver android:name=".AssistoWidgetProvider"'
              ' android:exported="false">'
              '\n            <intent-filter>'
              '\n                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>'
              '\n            </intent-filter>'
              '\n            <meta-data android:name="android.appwidget.provider"'
              ' android:resource="@xml/assisto_widget_info"/>'
              '\n        </receiver>'
              '\n        <receiver'
              ' android:name="com.assisto.assisto.AssistoDeviceAdminReceiver"'
              ' android:permission="android.permission.BIND_DEVICE_ADMIN"'
              ' android:exported="true">'
              '\n            <meta-data android:name="android.app.device_admin"'
              ' android:resource="@xml/device_admin"/>'
              '\n            <intent-filter>'
              '\n                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED"/>'
              '\n            </intent-filter>'
              '\n        </receiver>\n'
          )
          if '.AssistoWidgetProvider' not in s:
              s = s.replace('</application>', native_components + '    </application>', 1)
          # LAUNCH-ANR FIX: disable androidx.startup auto-initialization. This
          # phone (Realme/ColorOS) ANR'd at process start on the androidx
          # WorkManager startup ContentProvider before; androidx.camera (CameraX)
          # now pulls androidx.startup too. Removing the InitializationProvider
          # makes those libs lazy-init (CameraX inits on first use;
          # profileinstaller baseline profiles are a skippable perf optimisation)
          # so NOTHING heavy runs via a ContentProvider at cold start.
          startup_remove = (
              '\n        <provider android:name="androidx.startup.InitializationProvider"'
              ' android:authorities="${applicationId}.androidx-startup"'
              ' tools:node="remove"/>\n'
          )
          if 'androidx.startup.InitializationProvider' not in s:
              s = s.replace('</application>', startup_remove + '    </application>', 1)
          # ---- a6 FCM push ----
          # Full-screen incoming calls (Android 14+: user-grantable special
          # permission; Settings -> Notifications & calls deep-links to it).
          if 'USE_FULL_SCREEN_INTENT' not in s:
              s = re.sub(r'(<manifest[^>]*>)', r'\1' +
                  '\n    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>'
                  '\n    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>\n',
                  s, count=1)
          # A ringing call / SOS may open over the lock screen and wake it.
          if 'android:showWhenLocked' not in s:
              s = s.replace('android:name=".MainActivity"',
                  'android:name=".MainActivity"\n            android:showWhenLocked="true"'
                  '\n            android:turnScreenOn="true"', 1)
          push_components = (
              # NO startup ContentProvider: Firebase is initialised lazily (Dart
              # after the first frame; native AssistoFcmService when a push
              # arrives with the app closed).
              '\n        <provider android:name="com.google.firebase.provider.FirebaseInitProvider"'
              ' android:authorities="${applicationId}.firebaseinitprovider"'
              ' tools:node="remove"/>'
              # firebase_messaging's own startup provider only stores the app
              # context; the plugin's receiver, engine attach and our service
              # set the same holder, so it goes too (no startup providers).
              '\n        <provider android:name="io.flutter.plugins.firebase.messaging.FlutterFirebaseMessagingInitProvider"'
              ' android:authorities="${applicationId}.flutterfirebasemessaginginitprovider"'
              ' tools:node="remove"/>'
              # swap the plugin's messaging service for our subclass (it inits
              # Firebase on demand, crash-guarded)
              '\n        <service android:name="io.flutter.plugins.firebase.messaging.FlutterFirebaseMessagingService"'
              ' tools:node="remove"/>'
              '\n        <service android:name="com.assisto.assisto.push.AssistoFcmService"'
              ' android:exported="false">'
              '\n            <intent-filter>'
              '\n                <action android:name="com.google.firebase.MESSAGING_EVENT"/>'
              '\n            </intent-filter>'
              '\n        </service>'
              # notification messages that arrive before the app created its
              # channels land on "alerts" (channels are created in Dart:
              # messages / calls / reminders / alerts / sos)
              '\n        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id"'
              ' android:value="alerts"/>'
              # flutter_local_notifications receivers: notification ACTIONS
              # (call Accept/Decline) + scheduled reminders + reschedule on boot.
              # (The scheduled receivers were missing before, so zonedSchedule
              # reminders could not fire.)
              '\n        <receiver android:exported="false"'
              ' android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"/>'
              '\n        <receiver android:exported="false"'
              ' android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"/>'
              '\n        <receiver android:exported="false"'
              ' android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">'
              '\n            <intent-filter>'
              '\n                <action android:name="android.intent.action.BOOT_COMPLETED"/>'
              '\n                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>'
              '\n                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>'
              '\n                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>'
              '\n            </intent-filter>'
              '\n        </receiver>\n'
          )
          if 'AssistoFcmService' not in s:
              s = s.replace('</application>', push_components + '    </application>', 1)
          open(p, "w").write(s)
          print("manifest patched: label, permissions, queries, UCropActivity, native components, androidx.startup removed, FCM push")
          PY

      - name: Patch iOS Info.plist (camera/mic/photos usage strings)
        working-directory: app
        run: |
          python3 - <<'PY'
          import os
          p = "ios/Runner/Info.plist"
          if not os.path.exists(p):
              print("no iOS project (android-only build) — skipping Info.plist patch")
          else:
              s = open(p).read()
              entries = {
                  "NSCameraUsageDescription":
                      "Assisto uses the camera so you can take photos and record "
                      "videos to share with your circle or post as a status.",
                  "NSMicrophoneUsageDescription":
                      "Assisto uses the microphone to record audio while you shoot "
                      "a video to share with your circle.",
                  "NSPhotoLibraryUsageDescription":
                      "Assisto needs your photos so you can pick an existing picture "
                      "or video to share with your circle or post as a status.",
              }
              inject = ""
              for k, v in entries.items():
                  if k not in s:
                      inject += f"\t<key>{k}</key>\n\t<string>{v}</string>\n"
              if inject:
                  s = s.replace("</dict>\n</plist>", inject + "</dict>\n</plist>", 1)
                  open(p, "w").write(s)
                  print("Info.plist patched: camera/mic/photos usage strings")
              else:
                  print("Info.plist already has usage strings")
          PY

      - name: Enable core library desugaring (flutter_local_notifications)
        working-directory: app
        run: |
          python3 - <<'PY'
          import os
          kts = "android/app/build.gradle.kts"
          gr = "android/app/build.gradle"
          p, is_kts = (kts, True) if os.path.exists(kts) else (gr, False)
          s = open(p).read()
          # Force minSdk 26 (Android 8.0): the Health Connect plugin (#70) requires
          # 26; older plugins (file_picker / lifecycle / notifications) need 23. 26
          # covers ~96%+ of active devices in 2026 and old Android 6-7 phones can't
          # run Health Connect anyway.
          # strip any existing minSdk line, then inject into defaultConfig.
          import re as _re
          s = _re.sub(r'\n[ \t]*minSdk[A-Za-z]*\s*=?[^\n]*', '', s)
          inject = '\n        minSdk = 26' if is_kts else '\n        minSdkVersion 26'
          s = s.replace('defaultConfig {', 'defaultConfig {' + inject, 1)
          # compileSdk 36 (required by flutter_plugin_android_lifecycle)
          s = _re.sub(r'\n[ \t]*compileSdk[A-Za-z]*\s*=?[^\n]*', '', s)
          cinject = '\n    compileSdk = 36' if is_kts else '\n    compileSdk 36'
          s = s.replace('android {', 'android {' + cinject, 1)
          print("sdk lines now:",
                [l.strip() for l in s.splitlines() if 'Sdk' in l])
          if "coreLibraryDesugaring" not in s:
              if is_kts:
                  s = s.replace("compileOptions {",
                      "compileOptions {\n        isCoreLibraryDesugaringEnabled = true", 1)
                  s += ('\n\ndependencies {\n    coreLibraryDesugaring('
                        '"com.android.tools:desugar_jdk_libs:2.1.4")\n'
                        # a6 FCM: AssistoFcmService (android_overlay) extends the
                        # plugin's service; the plugins pull Firebase in as
                        # `implementation`, so the app module declares it too.
                        '    implementation(platform("com.google.firebase:firebase-bom:34.19.0"))\n'
                        '    implementation("com.google.firebase:firebase-messaging")\n}\n')
              else:
                  s = s.replace("compileOptions {",
                      "compileOptions {\n        coreLibraryDesugaringEnabled true", 1)
                  s += ("\n\ndependencies {\n    coreLibraryDesugaring "
                        "'com.android.tools:desugar_jdk_libs:2.1.4'\n"
                        "    implementation platform('com.google.firebase:firebase-bom:34.19.0')\n"
                        "    implementation 'com.google.firebase:firebase-messaging'\n}\n")
              open(p, "w").write(s)
              print("desugaring enabled in", p)
          else:
              print("already enabled")
          PY

      - name: Apply google-services Gradle plugin (only when Firebase config exists)
        working-directory: app
        run: |
          python3 - <<'PY'
          import os, re
          if not os.path.exists("android/app/google-services.json"):
              print("no google-services.json - google-services plugin NOT applied (push off)")
              raise SystemExit(0)
          GMS = "4.5.0"
          for settings in ("android/settings.gradle.kts", "android/settings.gradle"):
              if os.path.exists(settings):
                  s = open(settings).read()
                  if "com.google.gms.google-services" not in s:
                      kts = settings.endswith(".kts")
                      line = ('    id("com.google.gms.google-services") version "%s" apply false' % GMS
                              if kts else
                              '    id "com.google.gms.google-services" version "%s" apply false' % GMS)
                      s, n = re.subn(r'(\n[ \t]*id[ (]+"dev\.flutter\.flutter-plugin-loader"[^\n]*)',
                                     lambda m: m.group(1) + "\n" + line, s, count=1)
                      assert n == 1, "plugin-loader line not found in " + settings
                      open(settings, "w").write(s)
                  print("google-services plugin declared in", settings)
                  break
          for app in ("android/app/build.gradle.kts", "android/app/build.gradle"):
              if os.path.exists(app):
                  s = open(app).read()
                  if "com.google.gms.google-services" not in s:
                      kts = app.endswith(".kts")
                      line = ('    id("com.google.gms.google-services")' if kts
                              else '    id "com.google.gms.google-services"')
                      s, n = re.subn(r'(\n[ \t]*id[ (]+"dev\.flutter\.flutter-gradle-plugin"[^\n]*)',
                                     lambda m: m.group(1) + "\n" + line, s, count=1)
                      assert n == 1, "flutter-gradle-plugin line not found in " + app
                      open(app, "w").write(s)
                  print("google-services plugin applied in", app)
                  break
          PY

      - name: Build release APK (arm64 only)
        working-directory: app
        run: |
          API_BASE="${{ github.event.inputs.api_base || 'https://api.lifeassisto.com' }}"
          BUILD_TIME="$(date -u +%Y-%m-%dT%H:%MZ)"
          flutter build apk --release \
            --target-platform=android-arm64 \
            --build-number=${{ github.run_number }} \
            --build-name=1.0.${{ github.run_number }} \
            --dart-define=API_BASE="$API_BASE" \
            --dart-define=BUILD_TIME="$BUILD_TIME"

      - name: Build x86_64 debug APK (emulator smoke test only — NOT shipped)
        working-directory: app
        run: |
          # The shipped APK is arm64-only; x86_64 emulators can't load it. This
          # x64 debug APK has the SAME Dart, plugins and patched manifest, so it's
          # a valid launch/ANR proxy on the CI emulator.
          flutter build apk --debug --target-platform=android-x64 \
            --dart-define=API_BASE="${{ github.event.inputs.api_base || 'https://api.lifeassisto.com' }}" \
            --dart-define=BUILD_TIME="$(date -u +%Y-%m-%dT%H:%MZ)"
          cp build/app/outputs/flutter-apk/app-debug.apk emu-x64.apk

      - name: Upload emulator smoke APK
        uses: actions/upload-artifact@v4
        with:
          name: assisto-apk-emu
          path: app/emu-x64.apk
          retention-days: 3

      - name: Sign APK with permanent release key
        working-directory: app
        env:
          KS_PASS: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
          KS_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
          KEY_PASS: ${{ secrets.ANDROID_KEY_PASSWORD }}
        run: |
          set -e
          mkdir -p out
          echo "${{ secrets.ANDROID_KEYSTORE_B64 }}" | base64 -d > /tmp/ks.p12
          BT=$(ls -d "$ANDROID_HOME"/build-tools/*/ | sort -V | tail -1)
          echo "build-tools: $BT"
          SRC=build/app/outputs/flutter-apk/app-release.apk
          "${BT}zipalign" -f -p 4 "$SRC" /tmp/aligned.apk
          OUT="out/assisto-part7-build${{ github.run_number }}.apk"
          "${BT}apksigner" sign \
            --ks /tmp/ks.p12 --ks-type PKCS12 \
            --ks-pass pass:"$KS_PASS" \
            --ks-key-alias "$KS_ALIAS" \
            --key-pass pass:"$KEY_PASS" \
            --out "$OUT" /tmp/aligned.apk
          "${BT}apksigner" verify --print-certs "$OUT" | head -5
          rm -f /tmp/ks.p12 /tmp/aligned.apk
          ls -la out
          echo "size: $(du -h "$OUT" | cut -f1)"

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: assisto-apk
          path: app/out/*.apk
          retention-days: 14

  # Install the RELEASE APK on real Android emulators and prove it OPENS without
  # an ANR or crash within 60s. The whole run fails if this fails, so ship_watch
  # never publishes a broken-launch build. (Added after the build-99 launch ANR.)
  launch-smoke-test:
    needs: build-apk
    runs-on: ubuntu-latest
    # A hung adb call once held runs for 6h (builds 145/146: `adb logcat -d`
    # never returned). Healthy runs finish in ~5 min; cap the job.
    timeout-minutes: 40
    # Launch-safety gate: cold-start + open every native feature (the __tour__)
    # on an emulator. We test API 33 = the owner's Android 13 phone (the critical
    # target). API 30 was dropped from the gate: its x86_64 CI emulator kept
    # CRASHING the hosted runner (job 'cancelled', which continue-on-error cannot
    # salvage) and blocked 3 consecutive publishes (builds 110-112). API 33 passes
    # the identical tour reliably, and the owner also confirms launch on the real
    # Realme 9i (Android 13). Older-Android (API 30) CI coverage is PAUSED until a
    # stable emulator config is found — tracked in STATUS_FOR_OWNER.md.
    strategy:
      fail-fast: false
      matrix:
        api: [33]
    steps:
      - uses: actions/download-artifact@v4
        with:
          name: assisto-apk-emu
          path: apk
      - name: Enable KVM
        run: |
          echo 'KERNEL=="kvm", GROUP="kvm", MODE="0666", OPTIONS+="static_node=kvm"' | sudo tee /etc/udev/rules.d/99-kvm4all.rules
          sudo udevadm control --reload-rules
          sudo udevadm trigger --name-match=kvm
      - name: Launch smoke test (API ${{ matrix.api }})
        uses: reactivecircus/android-emulator-runner@v2
        with:
          api-level: ${{ matrix.api }}
          arch: x86_64
          # google_apis is the image that reliably boots headless on CI (every
          # build 102-108 reached LAUNCH OK on it within minutes). The AOSP
          # 'default' image hung >2h without booting. The GMS thrash only ever
          # hurt REPEATED relaunches — the single-cold-start __tour__ below does
          # one launch, so google_apis is both reliable and sufficient.
          target: google_apis
          profile: pixel_5
          disable-animations: true
          # Fail fast if an emulator can't boot (a flaky API-30 boot once dragged
          # a run past 30min). 8min is well above a healthy google_apis boot.
          emulator-boot-timeout: 480
          emulator-options: -no-snapshot -no-window -gpu swiftshader_indirect -noaudio -no-boot-anim
          # NOTE: this script runs under /bin/sh in the runner — use only
          # &&/|| one-liners (multi-line if/then/fi breaks it).
          script: |
            adb install -r apk/*.apk || { echo "install failed"; exit 1; }
            adb shell pm grant com.assisto.assisto android.permission.RECORD_AUDIO 2>/dev/null || true
            adb shell pm grant com.assisto.assisto android.permission.ACTIVITY_RECOGNITION 2>/dev/null || true
            adb shell pm grant com.assisto.assisto android.permission.BODY_SENSORS 2>/dev/null || true
            timeout 60 adb logcat -c || true
            # Single, race-free cold start (no prior instance right after install).
            # --es ao_open __tour__ makes the debug build walk every native-plugin
            # screen once IN-PROCESS (voice_sos, lost_stolen, watch_feed,
            # fall_detect), so each real plugin loads. Inert in the release APK.
            adb shell am start -n com.assisto.assisto/com.assisto.assisto.MainActivity --es ao_open __tour__ || adb shell monkey -p com.assisto.assisto -c android.intent.category.LAUNCHER 1
            sleep 60
            timeout 120 adb logcat -d > logcat.txt 2>/dev/null || { echo "::warning::adb logcat -d timed out/failed (adb infra); crash check uses what was captured"; timeout 60 adb logcat -d -t 3000 > logcat.txt 2>/dev/null || true; }
            echo "===== last 140 logcat lines ====="; tail -140 logcat.txt || true
            grep -E "FATAL EXCEPTION|ANR in com.assisto|com.assisto.assisto.*has died|FATAL SIGNAL|AndroidRuntime.*com.assisto|E/flutter.*(Unhandled|Fatal)" logcat.txt > crashes.txt 2>/dev/null || true
            test ! -s crashes.txt || { echo "::error::CRASH/ANR during launch+feature-tour on API ${{ matrix.api }}"; cat crashes.txt; exit 1; }
            timeout 30 adb shell pidof com.assisto.assisto > pid.txt 2>/dev/null || true
            test -s pid.txt || { echo "::error::app NOT running after launch+feature-tour on API ${{ matrix.api }}"; exit 1; }
            echo "LAUNCH + FEATURE-TOUR OK on API ${{ matrix.api }} pid=$(cat pid.txt)"
            # First-run language flow (BEST-EFFORT, on-device): a fresh install
            # opens on the language picker. Tap "Continue" (a full-width button
            # near the bottom — tap 50% width / 88% height from `wm size`, which
            # reliably lands on it regardless of density) and log whether we left
            # the picker. This is DIAGNOSTIC ONLY and must NEVER fail the build:
            # the authoritative, deterministic gate for this flow is the host
            # widget test (test/language_flow_test.dart, run in the build-apk
            # job). Flaky UI-automation taps once blocked publishes for days
            # (builds 110-112) — we never repeat that. The hard on-device gate
            # stays "app alive, no crash/ANR" below.
            SZ=$(adb shell wm size 2>/dev/null | tr -d '\r' | grep -oE '[0-9]+x[0-9]+' | tail -1)
            W=$(echo "$SZ" | cut -dx -f1); H=$(echo "$SZ" | cut -dx -f2)
            [ -n "$W" ] || W=1080; [ -n "$H" ] || H=2340
            TX=$((W/2)); TY=$((H*88/100))
            echo "screen=$SZ tapping Continue at $TX $TY" && adb shell input tap $TX $TY || true
            sleep 6
            timeout 30 adb shell pidof com.assisto.assisto > pid2.txt 2>/dev/null || true
            test -s pid2.txt || { echo "::error::app died after tapping Continue on API ${{ matrix.api }}"; exit 1; }
            timeout 60 adb shell uiautomator dump /sdcard/after.xml && timeout 60 adb pull /sdcard/after.xml after.xml 2>/dev/null || true
            if grep -q 'English' after.xml 2>/dev/null; then echo "::warning::on-device: still on language picker after tap (likely the UI-automation tap missed; host widget test is the real gate)"; else echo "LEFT the language picker — Continue entered the app OK"; fi
