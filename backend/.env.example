# Copy to backend/.env and fill in. Nothing machine-specific lives in code.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=assisto.asalify.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://assisto.asalify.com

# The single URL everything derives from. Change this (and DNS) to move servers.
ASSISTO_BASE_URL=https://assisto.asalify.com

# Database (own DB + own role in the shared PostgreSQL cluster)
DB_NAME=assisto
DB_USER=assisto
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Feature flags
SMS_ENABLED=false
AI_ENABLED=false
AI_PROVIDER=claude
AI_API_KEY=

# CORS (dev convenience)
CORS_ALLOW_ALL=false
CORS_ALLOWED_ORIGINS=
