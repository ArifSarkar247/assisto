# l1-launch: Safe Journey points past their privacy expiry + closed web deletion tickets (>180 days).
# Install (main session): append to the ubuntu crontab on the Assisto box.
25 * * * * cd /home/ubuntu/assisto/backend && /home/ubuntu/assisto/.venv/bin/python manage.py purge_l1_retention >> /home/ubuntu/assisto/logs/purge_l1_retention.log 2>&1
