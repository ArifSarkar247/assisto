<?xml version="1.0" encoding="utf-8"?>
<!--
  #80 Lost / stolen phone protection — device-admin policy set.

  Request ONLY what the feature actually uses (Play-policy minimal scope):
    * force-lock  -> lock the screen (DevicePolicyManager.lockNow): the owner's
                     or a trusted contact's remote "Lock" / "Lock-screen message"
                     switch (at100) and the optional lock on a detected grab
    * watch-login -> onPasswordFailed: wrong screen-unlock attempts are
                     recorded and reported to the owner's trusted contacts

  at100: limit-password and reset-password were declared but never used, and
  both are deprecated for device admins (Android 9 / 10) — removed.

  DELIBERATELY ABSENT: <wipe-data>. Remote wipe is NOT requested (Google Find
  Hub already offers a reliable erase; see
  owner_actions/ANTITHEFT_PLAY_DECLARATION_BN.md). Do not add it.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
        <watch-login />
    </uses-policies>
</device-admin>
