  "trustHeadline": "We do what we say",
  "trustIntro": "What Assisto does — and does not — do, honestly. Every statement below matches what the app actually does.",
  "trustWhatWeDo": "What we do",
  "trustWhatWeDont": "What we never do",
  "trustTransparency": "Transparency",
  "trustReadMore": "Read more",
  "trustMoneyTitle": "We never hold your money",
  "trustMoneyBody": "Assisto has no wallet and never charges you. To pay a bill it only pre-fills and opens your OWN bank / bKash / Nagad app — you press Send yourself.",
  "trustE2eTitle": "Your Circle chats are end-to-end encrypted",
  "trustE2eBody": "Text messages in Connected Circle are end-to-end encrypted; the server stores only the encrypted form and cannot read them. Photos, voice and video will come when encrypted storage is enabled — we do not claim them yet.",
  "trustAiTitle": "AI runs only with your key and consent",
  "trustAiBody": "No AI runs without an owner-provided AI key. AI never posts, pays or applies on its own. Anything it remembers is shown to you and you can delete it.",
  "trustSellTitle": "We never sell your data",
  "trustSellBody": "The app contains no third-party ad or tracking SDKs. Analytics are our own and identity-free (a hashed id, an allow-listed event, day-level buckets only).",
  "trustControlTitle": "Your data, your control",
  "trustControlBody": "You can export all your data at any time and delete your account. The document vault is PIN-locked.",
  "trustDataLocationTitle": "Where your data lives",
  "trustDataLocationBody": "Your data is stored on Assisto's own server. It is not sold or handed to any third party.",
  "trustNeverHoldMoney": "Hold or charge your money — never.",
  "trustNeverSell": "Sell your data or hand it to advertisers — never.",
  "trustNeverReadChats": "Read your encrypted chats — never.",
  "trustNeverAutoAct": "Post, pay or apply without your go-ahead — never.",
  "trustNeverTrackers": "Add third-party trackers — never.",
  "trustLicenseTitle": "Licensing & building blocks",
  "trustLicenseBody": "For encryption we aim to use permissively-licensed, auditable building blocks (for example OpenMLS — Apache/MIT). The app itself is not yet open source — we state this plainly rather than overclaim.",
  "trustOpenLegal": "Privacy policy & terms",
