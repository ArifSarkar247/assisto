import 'dart:async';

import 'package:flutter/foundation.dart';
import 'package:google_mobile_ads/google_mobile_ads.dart';

import 'ads_bridge.dart';

/// google_mobile_ads-backed [AdsBridge]. Non-personalized requests only.
/// Every SDK call is wrapped: an ads failure can never crash the app.
class AdmobAdsBridge implements AdsBridge {
  bool _ready = false;

  @override
  bool get linked => true;

  @override
  Future<bool> init() async {
    if (_ready) return true;
    try {
      await MobileAds.instance.initialize();
      _ready = true;
    } catch (e) {
      if (kDebugMode) debugPrint('ads init failed: $e');
      _ready = false;
    }
    return _ready;
  }

  static const _request = AdRequest(nonPersonalizedAds: true);

  @override
  Future<bool> showAppOpen(String unitId) async {
    if (!await init()) return false;
    final done = Completer<bool>();
    try {
      await AppOpenAd.load(
        adUnitId: unitId,
        request: _request,
        adLoadCallback: AppOpenAdLoadCallback(
          onAdLoaded: (ad) {
            ad.fullScreenContentCallback = FullScreenContentCallback(
              onAdShowedFullScreenContent: (_) {
                if (!done.isCompleted) done.complete(true);
              },
              onAdDismissedFullScreenContent: (a) => a.dispose(),
              onAdFailedToShowFullScreenContent: (a, _) {
                a.dispose();
                if (!done.isCompleted) done.complete(false);
              },
            );
            try {
              ad.show();
            } catch (_) {
              if (!done.isCompleted) done.complete(false);
            }
          },
          onAdFailedToLoad: (_) {
            if (!done.isCompleted) done.complete(false);
          },
        ),
      );
    } catch (_) {
      if (!done.isCompleted) done.complete(false);
    }
    return done.future.timeout(const Duration(seconds: 8), onTimeout: () => false);
  }

  @override
  Future<RewardOutcome> showRewarded(String unitId) async {
    if (!await init()) return RewardOutcome.unavailable;
    final done = Completer<RewardOutcome>();
    var earned = false;
    try {
      await RewardedAd.load(
        adUnitId: unitId,
        request: _request,
        rewardedAdLoadCallback: RewardedAdLoadCallback(
          onAdLoaded: (ad) {
            ad.fullScreenContentCallback = FullScreenContentCallback(
              onAdDismissedFullScreenContent: (a) {
                a.dispose();
                if (!done.isCompleted) {
                  done.complete(
                      earned ? RewardOutcome.earned : RewardOutcome.dismissed);
                }
              },
              onAdFailedToShowFullScreenContent: (a, _) {
                a.dispose();
                if (!done.isCompleted) done.complete(RewardOutcome.unavailable);
              },
            );
            try {
              ad.show(onUserEarnedReward: (_, __) => earned = true);
            } catch (_) {
              if (!done.isCompleted) done.complete(RewardOutcome.unavailable);
            }
          },
          onAdFailedToLoad: (_) {
            if (!done.isCompleted) done.complete(RewardOutcome.unavailable);
          },
        ),
      );
    } catch (_) {
      if (!done.isCompleted) done.complete(RewardOutcome.unavailable);
    }
    return done.future;
  }
}
